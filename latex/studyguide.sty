% ---------------------------------------------------------------- exam metadata badges
% \mks{2.5}              -> [2.5 M] pill   (NOT \marks — that is a TeX primitive)
% \asked{2022 Q3a, 2024 Q1b}  -> "Asked: ..." tag
% \clusterbadge{C05}     -> tier pill + P pill (or band pill), read from badges.tex (score.py output)
% \topicbadge{T07}       -> the topic's P pill (or band pill), read from badges.tex
%     WRITERS USE ONLY THESE TWO for tier/probability. Hand-typed \prob/\tier go stale when score.py
%     re-runs; lint flags them outside the auto chapters (05_how_to_use, 20_exam_radar).
% \prob{78}              -> "P 78%" pill coloured by band (high >= 50, med >= 25, low)
% \tier{A}               -> study-order badge: A = 3 h plan, B = added by 6 h, C = added by 12 h,
%                           D = wildcard (never asked, strong prior), E = the rest
% \src{N_slug p12}       -> grey source citation (traceability to instructor notes)
% All pills are robust: they may sit in moving arguments (\section titles, bookmarks), although
% lint asks you to put them after the heading instead.
\newcommand{\sg@pill}[3]{\tikz[baseline=(p.base)]\node[fill=#1,text=#2,rounded corners=2pt,
  inner xsep=3pt,inner ysep=1.2pt,font=\scriptsize\sffamily\bfseries](p){#3};}
\DeclareRobustCommand{\mks}[1]{\sg@pill{sgnavy}{white}{#1\,M}}
\DeclareRobustCommand{\asked}[1]{{\scriptsize\sffamily\color{sgteal}\textbf{Asked:} #1}}
\DeclareRobustCommand{\prob}[1]{\ifnum#1>49 \sg@pill{sgred}{white}{P #1\%}\else\ifnum#1>24
  \sg@pill{sgamber}{white}{P #1\%}\else\sg@pill{sggrid}{sgslate}{P #1\%}\fi\fi}
\newcommand{\sg@band}[1]{\ifstrequal{#1}{high}{\sg@pill{sgred}{white}{P high}}{%
  \ifstrequal{#1}{med}{\sg@pill{sgamber}{white}{P med}}{\sg@pill{sggrid}{sgslate}{P #1}}}}
\DeclareRobustCommand{\tier}[1]{\ifstrequal{#1}{A}{\sg@pill{sgred}{white}{A\,$\cdot$\,3\,h}}{%
  \ifstrequal{#1}{B}{\sg@pill{sgamber}{white}{B\,$\cdot$\,6\,h}}{%
  \ifstrequal{#1}{C}{\sg@pill{sgteal}{white}{C\,$\cdot$\,12\,h}}{%
  \ifstrequal{#1}{D}{\sg@pill{sgpurple}{white}{D\,$\cdot$\,\ifsg@phone wild\else wildcard\fi}}{%
  \sg@pill{sggrid}{sgslate}{#1\,$\cdot$\,later}}}}}}
\ifsg@phone
  % phone: a long corpus slug (N_SVP_Week6_Theory_Lecture2_Pattern_Matching_HMM) is one word wider than a box on
  % the 94 mm line (real SVP, 2026-11-06); seqsplit lets the grey citation break between any two characters
  \RequirePackage{seqsplit}
  % split only the slug (seqsplit drops spaces); " p2-3, p14" after the first space is kept as written
  \def\sg@srcA#1 #2\@nil{\seqsplit{#1}\if\relax\detokenize{#2}\relax\else\ \sg@srcB#2\@nil\fi}
  \def\sg@srcB#1 \@nil{#1}   % drop the space \src appended before \@nil
  \DeclareRobustCommand{\src}[1]{{\scriptsize\sffamily\color{muted}[\expandafter\sg@srcA\detokenize{#1} \@nil]}}
\else
  \DeclareRobustCommand{\src}[1]{{\scriptsize\sffamily\color{muted}[\detokenize{#1}]}}
\fi
\DeclareRobustCommand{\ev}[1]{\sg@pill{sggreen}{white}{EV #1}}   % expected marks

% badges.tex (written by score.py on every run; \input automatically when it is on the path):
%   \sgdefbadge{C05}{A}{79}{high}{1.58}   cluster: tier, P integer percent or "-", band, EV
%   \sgdeftopic{T07}{84}{high}            topic:   P integer percent or "-", band
\newcommand{\sg@ppill}[2]{\ifstrequal{#1}{-}{\sg@band{#2}}{\prob{#1}}}
\newcommand{\sgdefbadge}[5]{%
  % breakable gap: in narrow table cells (phone edition) the P pill wraps under the tier pill
  \csgdef{sg@b@#1}{\tier{#2}\hspace{0.17em plus 0.1em}\allowbreak\sg@ppill{#3}{#4}}%
  \ifstrequal{#3}{-}{\csgdef{sg@bt@#1}{[#2, P #4]}}{\csgdef{sg@bt@#1}{[#2, P #3\%]}}%
  \csgdef{sg@ev@#1}{#5}}
\newcommand{\sgdeftopic}[3]{%
  \csgdef{sg@t@#1}{\sg@ppill{#2}{#3}}%
  \ifstrequal{#2}{-}{\csgdef{sg@tt@#1}{[P #3]}}{\csgdef{sg@tt@#1}{[P #2\%]}}}
\newcommand{\sg@missingbadge}[1]{\typeout{SG-BADGE-MISSING:#1}\sg@pill{sgred}{white}{?#1}}
\DeclareRobustCommand{\clusterbadge}[1]{\ifcsdef{sg@b@#1}{\csuse{sg@b@#1}}{\sg@missingbadge{#1}}}
\DeclareRobustCommand{\topicbadge}[1]{\ifcsdef{sg@t@#1}{\csuse{sg@t@#1}}{\sg@missingbadge{#1}}}
\AtBeginDocument{\IfFileExists{badges.tex}{\input{badges.tex}}{}}
% text forms for PDF bookmarks (hyperref expands section titles into plain strings)
\pdfstringdefDisableCommands{%
  \def\mks#1{[#1 M]}\def\prob#1{[P #1\%]}\def\tier#1{[#1]}\def\ev#1{[EV #1]}%
  \def\asked#1{}\def\src#1{}\def\stepno#1{#1}\def\answer#1{#1}\def\keyword#1{#1}%
  \def\clusterbadge#1{\ifcsname sg@bt@#1\endcsname\csname sg@bt@#1\endcsname\else[?#1]\fi}%
  \def\topicbadge#1{\ifcsname sg@tt@#1\endcsname\csname sg@tt@#1\endcsname\else[?#1]\fi}%
  \def\flashcard#1#2{}\def\notfromnotes#1{}}

% ---------------------------------------------------------------- boxes
\tcbset{sgbase/.style={enhanced,breakable,arc=2mm,boxrule=0.8pt,left=6pt,right=6pt,
  top=4pt,bottom=4pt,fonttitle=\sffamily\bfseries\small,before skip=6pt,after skip=6pt}}
\newtcolorbox{definitionbox}[1][]{sgbase,colback=sgtint,colframe=sgnavy,
  title={Definition\ifstrempty{#1}{}{: #1}}}
\newtcolorbox{keyconceptbox}[1][]{sgbase,colback=sgteal!5,colframe=sgteal,
  title={Key idea\ifstrempty{#1}{}{: #1}}}
\newtcolorbox{formulabox}[1][]{sgbase,colback=sgamber!6,colframe=sgamber,
  title={Formula\ifstrempty{#1}{}{: #1}}}
\newtcolorbox{algorithmbox}[1][]{sgbase,colback=white,colframe=sgslate,
  title={Algorithm\ifstrempty{#1}{}{: #1}}}
\newtcolorbox{warningbox}[1][]{sgbase,colback=sgred!4,colframe=sgred,
  title={Exam pitfall\ifstrempty{#1}{}{: #1}}}
\newtcolorbox{intuitionbox}[1][]{sgbase,colback=sgpurple!4,colframe=sgpurple,
  title={Intuition\ifstrempty{#1}{}{: #1}}}
\newtcolorbox{mnemonicbox}[1][]{sgbase,colback=sggreen!5,colframe=sggreen,
  title={Remember it\ifstrempty{#1}{}{: #1}}}
