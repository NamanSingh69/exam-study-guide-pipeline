\newtcolorbox{answerplan}[1][]{sgbase,colback=white,colframe=sggreen,borderline west={3pt}{0pt}{sggreen},
  title={Answer plan for full marks\ifstrempty{#1}{}{ — #1}}}
\newtcolorbox{examtip}[1][]{sgbase,colback=sgamber!4,colframe=sgamber!80!black,
  title={Exam tip\ifstrempty{#1}{}{: #1}}}
\newtcolorbox{checkpoint}[1][]{sgbase,colback=white,colframe=sgteal,boxrule=0.6pt,
  title={Self-check\ifstrempty{#1}{}{: #1}}}

% Question box: \begin{question}{2024 Midsem Q2(a)}{2.5}  verbatim text \end{question}
% optional 3rd arg: frequency tag text, e.g. {Asked 3/3 papers}
\NewDocumentEnvironment{question}{m m O{}}{%
  \begin{tcolorbox}[sgbase,colback=sgnavy!4,colframe=sgnavy,
    title={\textsf{#1}\hfill\ifstrempty{#3}{}{{\scriptsize #3}\ }\mks{#2}}]\itshape}{\end{tcolorbox}}
\newtcolorbox{solution}[1][]{sgbase,colback=white,colframe=sgteal,boxrule=0.6pt,
  title={Solution\ifstrempty{#1}{}{ — #1}}}
% final answer highlight usable in text and math
\newcommand{\answer}[1]{\tcbox[on line,colback=sgamber!12,colframe=sgamber,boxrule=0.6pt,
  arc=1.5pt,left=2pt,right=2pt,top=1pt,bottom=1pt]{#1}}

% ---------------------------------------------------------------- tables
% L{w}: fixed ragged column. Writers size w for the A4 text width (~160 mm); on the phone page the same
% widths starve the X/Y column (real CN T10: 70 mm of fixed columns, 50 pt overfull), so [phone] scales
% them by 0.6 (about the phone/A4 text-width ratio).
\ifsg@phone
  % 0.7 x w, but never below min(w, 16 mm): a short column must still hold one word ("CNAME") or one pill
  \newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{\sg@phonecol{#1}}}
  \AtBeginEnvironment{tabularx}{\footnotesize}   % phone: tables one size down so cells hold their words
  \newcommand{\sg@phonecol}[1]{\dimexpr\ifdim\dimexpr(#1)*7/10\relax<\ifdim#1<16mm #1\else16mm\fi
    \ifdim#1<16mm #1\else16mm\fi\else(#1)*7/10\fi\relax}
\else
  \newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\fi
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcommand{\zebra}{\rowcolors{2}{sgtint}{white}}
\renewcommand{\theadfont}{\bfseries\sffamily}

