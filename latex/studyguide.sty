  treenode/.style={circ,minimum size=7mm},
  % grouping
  group/.style={draw=muted,dashed,rounded corners=4pt,inner sep=6pt},
  grouplabel/.style={font=\scriptsize\sffamily\bfseries,text=muted,fill=white,inner sep=1pt},
  % step number bubble
  stepbubble/.style={circle,fill=hl,text=white,font=\scriptsize\bfseries,inner sep=1pt,minimum size=4.2mm},
}
% \stepno{3} inline numbered bubble (for "steps" in explanations and diagrams)
\newcommand{\stepno}[1]{\tikz[baseline=(s.base)]\node[stepbubble](s){#1};}

% ---------------------------------------------------------------- storyboards & animations
% \stepanim{<frames>}{<cols>}{<frame width>}{<caption>}{<tikz body using \f>}
%   Write ONE parametrised tikz body. Inside it, \f is the current frame number (1..N);
%   use \ifnum\f>2 ... \fi to reveal things progressively, and \framecap{...} (optional) is
%   ignored by LaTeX but documents intent.
%   Output: print edition  -> storyboard grid "Step 1 .. Step N" (every viewer, paper)
%           [interactive]  -> an animation with play controls (Acrobat / Okular / Foxit), followed
%                             by the same storyboard (Chrome/Edge/phone viewers show frame 1 only)
%           [phone]        -> the storyboard, one frame per row, inline (may break across pages)
%   Keep the bounding box constant across frames: draw an invisible frame box first, e.g.
%   \path[use as bounding box] (-0.3,-0.3) rectangle (6,3.2);
%   Legibility: at most 2 frames per row (frame width >= 0.45\linewidth) unless frames are tiny strips;
%   labels >= \scriptsize, horizontal where possible.
%   Placement is [!htbp] so big storyboards float instead of leaving half-empty pages.
\newcounter{sganim}
\newcommand{\sg@frametitle}[1]{\node[anchor=north west,font=\scriptsize\sffamily\bfseries,
  text=white,fill=sgnavy,rounded corners=1pt,inner sep=1.5pt] at (current bounding box.north west) {Step #1};}
% Starred forms \stepanim* / \storyboard* are INLINE (no float, \captionof): use them inside boxes
% (solution, answerplan ...) where floats are not allowed ("Float(s) lost").
\newcommand{\sg@frames}[4]{% #1 frames #2 cols #3 width #4 body
  \ifsg@phone\sg@framesgrid{#1}{1}{\linewidth}{#4}\else\sg@framesgrid{#1}{#2}{#3}{#4}\fi}
\newcommand{\sg@framesgrid}[4]{%
  \foreach \sg@k in {1,...,#1}{%
    \begin{minipage}[t]{#3}\centering
      \begin{tikzpicture}\edef\f{\sg@k}#4\sg@frametitle{\sg@k}\end{tikzpicture}
    \end{minipage}%
    \pgfmathparse{int(mod(\sg@k,#2))}%
    \ifnum\pgfmathresult=0 \par\vspace{4pt}\else\hfill\fi
  }}
\newcommand{\sg@anim}[2]{% #1 frames #2 body
  \begin{animateinline}[controls=all,loop,palindrome=false,poster=first,
     begin={\begin{tikzpicture}},end={\end{tikzpicture}}]{0.7}
    \multiframe{#1}{iF=1+1}{\edef\f{\iF}#2\sg@frametitle{\f}}
  \end{animateinline}}
\newcommand{\sg@animnote}[1]{{\scriptsize\color{muted}(animation: press play; #1 steps. The same
  steps are printed as a storyboard below for viewers that cannot play it)}}
\NewDocumentCommand{\stepanim}{s m m m m +m}{%
  \refstepcounter{sganim}%
  \ifsg@animate
    \IfBooleanTF{#1}%
      {\par\begin{center}\sg@anim{#2}{#6}\captionof{figure}{#5 \sg@animnote{#2}}\end{center}%
       \begingroup\let\label\@gobble   % the caption prints twice: only the animation keeps its \label
       \storyboard*{#2}{#3}{#4}{#5 {\scriptsize\color{muted}(storyboard)}}{#6}\endgroup}%
      {\begin{figure}[!htbp]\centering\sg@anim{#2}{#6}%
         \caption{#5 \sg@animnote{#2}}\end{figure}%
       \begingroup\let\label\@gobble
       \storyboard{#2}{#3}{#4}{#5 {\scriptsize\color{muted}(storyboard)}}{#6}\endgroup}%
  \else
    \IfBooleanTF{#1}{\storyboard*{#2}{#3}{#4}{#5}{#6}}{\storyboard{#2}{#3}{#4}{#5}{#6}}%
  \fi}

% \storyboard is the print-only variant (no animation even in the interactive edition).
% In the phone edition every storyboard is inline (one frame per row; it may break across pages).
\NewDocumentCommand{\storyboard}{s m m m m +m}{%
  \ifsg@phone\sg@inlineboard{#2}{#3}{#4}{#5}{#6}\else
  \IfBooleanTF{#1}%
    {\sg@inlineboard{#2}{#3}{#4}{#5}{#6}}%
    {\begin{figure}[!htbp]\centering\sg@frames{#2}{#3}{#4}{#6}\caption{#5}\end{figure}}\fi}
\newcommand{\sg@inlineboard}[5]{\par\begin{center}\sg@frames{#1}{#2}{#3}{#5}\captionof{figure}{#4}\end{center}}

% ---------------------------------------------------------------- misc helpers
\newcommand{\figfromnotes}[3][0.8]{% \figfromnotes[width]{figures/src/x.png}{caption (source)}
  \begin{figure}[!htbp]\centering\includegraphics[max width=#1\linewidth,max height=0.42\textheight]{#2}
  \caption{#3}\end{figure}}
\DeclareRobustCommand{\keyword}[1]{\textbf{\color{sgnavy}#1}}

% ---------------------------------------------------------------- Round 4: receipts, provenance, atoms
% \receipt{MS2024-1c}   the question as printed on the paper: receipts/<qid>.png (receipts.py output)
%                       in a thin grey frame, captioned "From the paper". Missing file -> red box +
%                       \typeout{SG-RECEIPT-MISSING:<qid>} (metrics.py counts these).
% Receipts are evidence, not reading text: about 60% of the paper's own size on A4 (full width on phone),
% so a PYQ chapter is not doubled in length by its crops (Round 4: older-paper chapters ran 2-3x budget).
\newcommand{\sg@receiptw}{\ifsg@phone\dimexpr\linewidth-6pt\relax\else0.62\linewidth\fi}% -6pt: the frame's sep + rule
\newcommand{\receipt}[1]{\par\IfFileExists{receipts/#1.png}{%
    \begin{center}\setlength{\fboxsep}{2pt}\setlength{\fboxrule}{0.4pt}%
    \fcolorbox{sggrid}{white}{\includegraphics[max width=\sg@receiptw,max height=0.2\textheight]{receipts/#1.png}}\par
    \nopagebreak\vspace{1pt}{\upshape\scriptsize\sffamily\color{muted}From the paper (\detokenize{#1})}\end{center}}%
  {\typeout{SG-RECEIPT-MISSING:#1}%
    \begin{center}\setlength{\fboxsep}{3pt}\fcolorbox{sgred}{sgred!6}{\upshape\scriptsize\sffamily
    \color{sgred}\textbf{receipt missing:} \detokenize{#1}}\end{center}}}
% \notfromnotes{Forouzan, ch. 5}   red banner at the top of a section whose content is NOT in the
%                       instructor's notes (unfillable coverage gap). Use instead of \src there.
\newcommand{\notfromnotes}[1]{\par
  \begin{tcolorbox}[enhanced,colback=sgred!7,colframe=sgred,boxrule=0.8pt,arc=1mm,left=5pt,right=5pt,
    top=2pt,bottom=2pt,before skip=4pt,after skip=6pt,fontupper=\small\sffamily]
  \textbf{\color{sgred}Not in your instructor's notes} --- written from #1; check it against class material.
  \end{tcolorbox}}
% \begin{solvedidea}{C05}{Stop-and-wait with periodic loss} ... \end{solvedidea}
%                       THE one full model solution of a question idea (atoms/solve/C05.tex).
%                       Sets \label{solve:C05}; every other place uses \seesolved{C05}.
\newcounter{sgsolve}
\NewDocumentEnvironment{solvedidea}{m +m}{%
  \begin{tcolorbox}[sgbase,colback=white,colframe=sggreen!70!black,borderline west={3pt}{0pt}{sggreen},
    title={Solved idea: #2\hfill\clusterbadge{#1}}]%
  \refstepcounter{sgsolve}\def\@currentlabelname{#2}\label{solve:#1}}%
  {\end{tcolorbox}}
% ---------------------------------------------------------------- two documents: Guide <-> PYQ archive
% Older papers (assignments.json kind pyq_older) are built into a separate PYQ archive PDF. build.py writes a
% table of the OTHER document's labels (from its sources; pages and numbers from its .aux when it has been
% built) into _xref_<job>.tex, read in the preamble:
%   \sgxdoc{G}{Guide}{<file>.pdf}          a document: key, display name, PDF file (same folder)
%   \sgxlabel{G}{solve:C05}{num}{page}{title}   one of its labels (page may be empty: not built yet)
%   \sgxq{MS2022-1a}{MS2022}{1(a)}         paper id and question number of an archived question
% Labels defined in this document never appear in the table, so local refs are unchanged. A ref to a label
% that is in neither document is an ordinary undefined reference (a hard error on full builds).
% Every external use writes \typeout{SG-XREF:<doc>:<label>:resolved|pending} for build.py / metrics.py.
\newcommand{\sgxdoc}[3]{\csgdef{sgx@name@#1}{#2}\csgdef{sgx@file@#1}{#3}}
% Each external label is also defined the way xr does it (\r@<label>, empty anchor = no local link), so plain
% \ref / \pageref / \nameref print "3.2", "12 (Guide)" (or "(Guide)" before it is built) and the title.
\newcommand{\sgxlabel}[5]{\csgdef{sgx@d@#2}{#1}\csgdef{sgx@n@#2}{#3}\csgdef{sgx@p@#2}{#4}\csgdef{sgx@t@#2}{#5}%
  \ifstrempty{#4}{\csgdef{r@#2}{{#3}{(\csuse{sgx@name@#1})}{#5}{}{}}}%
                 {\csgdef{r@#2}{{#3}{#4 (\csuse{sgx@name@#1})}{#5}{}{}}}}
\newcommand{\sgxq}[3]{\csgdef{sgx@qp@#1}{#2}\csgdef{sgx@qn@#1}{#3}}
% \sg@xlink{label}{text}: "text, p. N" linked to page N of the other PDF ("text" alone while it is unbuilt)
\newcommand{\sg@xlink}[2]{\edef\sg@xd{\csuse{sgx@d@#1}}%
  \ifcsempty{sgx@p@#1}{\typeout{SG-XREF:\sg@xd:#1:pending}#2}%
    {\typeout{SG-XREF:\sg@xd:#1:resolved}%
     \href[page=\csuse{sgx@p@#1}]{\csuse{sgx@file@\sg@xd}}{#2, p.~\csuse{sgx@p@#1}}}}
\newcommand{\sg@xname}[1]{\csuse{sgx@name@\csuse{sgx@d@#1}}}
% \seesolved{C05}       "Same idea as <title>: full solution on p. N" (links to solve:C05); when the solution
%                       is in the other document: "... full solution in the Guide, p. N"
\newcommand{\seesolved}[1]{\typeout{SG-REF:solve:#1}%
  \ifcsdef{sgx@d@solve:#1}%
    {{\sffamily\small\color{sgteal}Same idea as \textit{\csuse{sgx@t@solve:#1}}: full solution in the
      \sg@xlink{solve:#1}{\sg@xname{solve:#1}}}}%
    {{\sffamily\small\color{sgteal}Same idea as \textit{\nameref{solve:#1}}: full solution on
      p.~\pageref{solve:#1}}}}
% \pyqsolved{MS2024-1c} link text "solved on p. N" to q:<qid>; \typeout{SG-REF:q:<qid>} lets the
%                       build tell a dangling link from a chapter that is missing. A question of an archived
%                       paper prints "PYQ archive, MS2022 1(a), p. N"; one solved in the Guide (seen from
%                       the archive) prints "solved in the Guide, p. N".
\newcommand{\pyqsolved}[1]{\typeout{SG-REF:q:#1}%
  \ifcsdef{sgx@d@q:#1}%
    {\ifcsdef{sgx@qp@#1}%
      {\sg@xlink{q:#1}{\sg@xname{q:#1}, \csuse{sgx@qp@#1} \csuse{sgx@qn@#1}}}%
      {\sg@xlink{q:#1}{solved in the \sg@xname{q:#1}}}}%
    {\hyperref[q:#1]{solved on p.~\pageref*{q:#1}}}}
% \flashcard{front}{back}  prints nothing; flashcards.py collects them (2-5 per topic).
\NewDocumentCommand{\flashcard}{+m +m}{\@bsphack\@esphack}
% chapter-end page markers written by build.py's wrapper (metrics: pages per chapter)
\newcommand{\sgchapterend}[2]{}
\newcommand{\sgmarkchapterend}[1]{\protected@write\@auxout{}{\string\sgchapterend{#1}{\thepage}}}
