% ---------------------------------------------------------------- phone geometry helpers
% 10.5 pt body on a ~94 mm text block. Wide TikZ pictures and plain tabulars are shrunk to
% \linewidth (outermost one only; never enlarged). tabularx with fixed-width columns is typeset wider,
% then shrunk; xltabular (breaks across pages) cannot be boxed. Display maths is shrunk to fit.
\newif\ifsg@infit   % defined outside \ifsg@phone: an undefined \if.. inside a skipped branch would unbalance it
\ifsg@phone
  \renewcommand\normalsize{\@setfontsize\normalsize{10.5}{12.8}%
    \abovedisplayskip 6\p@ \@plus2\p@ \@minus3\p@
    \abovedisplayshortskip \z@ \@plus2\p@
    \belowdisplayshortskip 4\p@ \@plus2\p@ \@minus2\p@
    \belowdisplayskip \abovedisplayskip
    \let\@listi\@listI}
  \normalsize
  \sloppy\setlength{\emergencystretch}{6em}   % long unbreakable slugs/pills on a 94 mm line
  % Only the outermost picture/table is boxed. Group-local bookkeeping (no global counter that an
  % environment with unusual end handling could leave unbalanced): the outermost level defines
  % \sg@closeme inside its adjustbox group; nested levels make it undefined inside their own group.
  \newcommand{\sg@fitbegin}{\ifsg@infit\let\sg@closeme\@undefined\else
    \begin{adjustbox}{max width=\linewidth,max totalheight=0.8\textheight}\sg@infittrue\def\sg@closeme{}\fi}
  \newcommand{\sg@fitend}{\ifdefined\sg@closeme\end{adjustbox}\fi}
  \BeforeBeginEnvironment{tikzpicture}{\sg@fitbegin}
  \AfterEndEnvironment{tikzpicture}{\sg@fitend}
  \BeforeBeginEnvironment{tabular}{\sg@fitbegin}
  \AfterEndEnvironment{tabular}{\sg@fitend}
  % tabularx with fixed or natural-width columns (p/m/b/L{..}, l/c/r) was sized for A4: typeset it 1.4x wider,
  % then shrink, instead of squeezing its X columns until words overflow (pure X/Y tables keep \linewidth).
  \BeforeBeginEnvironment{tabularx}{\sg@fitbegin}
  \AfterEndEnvironment{tabularx}{\sg@fitend}
  \AtBeginDocument{%
    \let\sg@tabularx\tabularx
    \def\tabularx#1#2{\ifdefined\sg@closeme\sg@iffixedcols{#2}{\setlength{\linewidth}{1.4\linewidth}}{}\fi
      \sg@tabularx{#1}{#2}}}
  \newcommand{\sg@iffixedcols}[3]{\@tempswafalse
    \in@{p}{#1}\ifin@\@tempswatrue\fi \in@{m}{#1}\ifin@\@tempswatrue\fi
    \in@{b}{#1}\ifin@\@tempswatrue\fi \in@{L}{#1}\ifin@\@tempswatrue\fi
    \in@{l}{#1}\ifin@\@tempswatrue\fi \in@{c}{#1}\ifin@\@tempswatrue\fi \in@{r}{#1}\ifin@\@tempswatrue\fi
    \if@tempswa #2\else #3\fi}
  % a final-answer box cannot break: never wider than the line
  \AtBeginDocument{\tcbset{every box/.append style={before upper app={\sloppy\emergencystretch=4em}}}}
  \newdimen\sg@answd   % measured outside the box: inside \tcbox, \linewidth is not the line's width
  \AtBeginDocument{\let\sg@answerbox\answer
    \renewcommand{\answer}[1]{\sg@answd=0.8\linewidth
      \ifmmode\else\hfil\penalty\z@\hfilneg\fi   % a painless break before the box (in boxes TeX refuses a bad line)
      \sg@answerbox{\adjustbox{max width=\sg@answd}{#1}}}}
  % display maths cannot break: shrink \[..\], equation* and align* that are wider than the line
  \newcommand{\sg@fitdisplay}[1]{\par\addvspace{\abovedisplayskip}\noindent
    \makebox[\linewidth]{\adjustbox{max width=\linewidth}{$\displaystyle #1$}}\par\addvspace{\belowdisplayskip}}
  \RequirePackage{environ}
  \AtBeginDocument{%
    \protected\def\[#1\]{\sg@fitdisplay{#1}}%
    \RenewEnviron{equation*}{\sg@fitdisplay{\BODY}}%
    \RenewEnviron{align*}{\sg@fitdisplay{\begin{aligned}\BODY\end{aligned}}}%
    % real SVP T05/T06 (2026-11-06): multi-line gather* formula boxes overflowed the phone page by 80-110 pt
    \RenewEnviron{gather*}{\sg@fitdisplay{\begin{gathered}\BODY\end{gathered}}}}
\fi

