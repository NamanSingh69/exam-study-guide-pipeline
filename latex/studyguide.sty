\newif\ifsg@cheat   \sg@cheatfalse         % [cheatsheet] -> dense landscape layout
\newif\ifsg@phone   \sg@phonefalse         % [phone] -> small single-column page
\DeclareOption{interactive}{\sg@animatetrue}
\DeclareOption{noanim}{\sg@animatefalse}   % kept for compatibility (= default)
\DeclareOption{cheatsheet}{\sg@cheattrue}
\DeclareOption{phone}{\sg@phonetrue}
\ProcessOptions\relax
\ifsg@phone\sg@animatefalse\sg@cheatfalse\fi   % phone viewers cannot play animate; never landscape

